{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sinteticalabs.com/schema/config/v2.json",
  "title": "Configuración de un bicho (SintéticaOS)",
  "description": "El único documento que guarda un bicho. La app y la web lo editan y se lo mandan entero o por partes. Caras, animaciones y reglas son datos, nunca código. La v2 suma el motor de vida: expresiones paramétricas, comportamientos, personalidad de 6 rasgos, horario, dueño y límites de la marca (docs/motor-de-vida.md). Una config v1 sigue siendo válida.",
  "type": "object",
  "required": [
    "version"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "enum": [
        1,
        2
      ]
    },
    "nombre": {
      "type": "string",
      "minLength": 1,
      "maxLength": 24
    },
    "cara": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ojos": {
          "type": "string",
          "description": "Preset de ojos. Por ahora solo \"pastilla\"."
        },
        "color": {
          "$ref": "#/$defs/colorHex",
          "description": "Reemplaza al naranja de pantalla en los ojos."
        },
        "tamano": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 1.5
        }
      }
    },
    "personalidad": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preset": {
          "enum": [
            "equilibrado",
            "timido",
            "picaro",
            "dormilon",
            "carinoso",
            "curioso",
            "grunon",
            "electrico"
          ],
          "description": "Arranca de un preset; los rasgos que vengan lo ajustan."
        },
        "energia": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Alto: se mueve mucho, resortes rápidos, duerme poco. Bajo: tranquilo, siestero."
        },
        "sociabilidad": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Alto: busca atención y se aburre rápido solo. Bajo: independiente."
        },
        "picardia": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Alto: guiños, bromas, finge dormir. Bajo: serio."
        },
        "timidez": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Alto: se asusta y se avergüenza fácil. Bajo: valiente."
        },
        "curiosidad": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Alto: investiga todo. Bajo: se concentra."
        },
        "malGenio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Alto: se enoja rápido y se le pasa lento. Bajo: paciente."
        },
        "sueno": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]-([01][0-9]|2[0-3]):[0-5][0-9]$",
          "description": "Horario en que duerme, HH:MM-HH:MM (puede cruzar la medianoche)."
        }
      }
    },
    "expresiones": {
      "type": "object",
      "description": "Expresiones propias o que reemplazan a las base, por nombre. Con \"formas\" es un dibujo (v1); si no, una expresión paramétrica del motor de vida.",
      "maxProperties": 48,
      "propertyNames": {
        "$ref": "#/$defs/nombreExpresion"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "$ref": "#/$defs/expresion"
          },
          {
            "$ref": "#/$defs/expresionVida"
          }
        ]
      }
    },
    "animaciones": {
      "type": "object",
      "description": "Animaciones por nombre: cada pista es una forma que se mueve, escala, gira y cambia de color y opacidad con claves en el tiempo. Se usan en la lista (animacion:<nombre>), en las reglas y con el comando Reproducir.",
      "maxProperties": 6,
      "propertyNames": {
        "$ref": "#/$defs/nombreExpresion"
      },
      "additionalProperties": {
        "$ref": "#/$defs/animacion"
      }
    },
    "reglas": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "type": "object",
        "required": [
          "si",
          "entonces"
        ],
        "additionalProperties": false,
        "properties": {
          "si": {
            "type": "string",
            "description": "Un evento (tacto, toque, doble-toque, levantado, sacudida, boca-abajo, vinculado, app-abierta, despertado, caricia, muchos-toques, sacudida-suave, sacudida-fuerte, inclinado, caida, voz, nombre, ruido, musica, silencio, notificacion, llamada, bateria-baja, bateria-critica, enchufado, desenchufado, cargado, sin-wifi, cambio-de-cara, bicho-cerca, volvio, hito; también con _ o . en vez de -, como \"sacudida.fuerte\") o una condición de estado (bateria<15, humor>0.5).",
            "pattern": "^([a-z][a-z._-]*|(bateria|humor)[<>]-?[0-9]+(\\.[0-9]+)?)$"
          },
          "entonces": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": {
              "type": "string",
              "pattern": "^((expresion|sonido|led|animacion|reflejo|comportamiento|particula):[a-z0-9#-]+|estado\\.(energia|animo|afecto|aburrimiento|curiosidad|sueno|estres)[+-](0(\\.[0-9]+)?|1(\\.0+)?))$"
            }
          },
          "y": {
            "type": "string",
            "description": "Condiciones extra separadas por coma: \"afecto>0.6\", \"rasgo.timidez>0.5\", \"dormido\", \"noche\".",
            "pattern": "^[a-zA-Z._]+([<>]-?[0-9]+(\\.[0-9]+)?)?(,[a-zA-Z._]+([<>]-?[0-9]+(\\.[0-9]+)?)?)?$"
          }
        }
      }
    },
    "modo": {
      "enum": [
        "mascota",
        "reloj",
        "pomodoro",
        "clima",
        "notificaciones"
      ]
    },
    "lista": {
      "type": "array",
      "maxItems": 16,
      "description": "Lo que se muestra, en orden: un toque en el broche pasa al siguiente. Sin lista, el broche recorre las caras y la mascota se maneja sola.",
      "items": {
        "type": "string",
        "pattern": "^(cara:[a-z][a-z0-9-]{0,23}|animacion:[a-z][a-z0-9-]{0,23}|imagen:[0-7])$"
      }
    },
    "rotar": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1440,
      "description": "Cada cuántos minutos la lista pasa sola al siguiente; 0 = no rota."
    },
    "semilla": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295,
      "description": "Semilla del azar del motor de vida (0 = la del hardware). Con la misma semilla, el mismo bicho hace exactamente lo mismo."
    },
    "horario": {
      "type": "object",
      "additionalProperties": false,
      "description": "El horario del dueño: fuera de él, el bicho duerme (por defecto 08:00 a 23:30).",
      "properties": {
        "despierta": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "duerme": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        }
      }
    },
    "dueno": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nombre": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24
        },
        "cumple": {
          "type": "string",
          "pattern": "^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
        }
      }
    },
    "cumple": {
      "type": "string",
      "pattern": "^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$",
      "description": "El cumpleaños del bicho (la fecha de armado), MM-DD."
    },
    "limites_marca": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "color": {
          "$ref": "#/$defs/colorHex"
        },
        "brillo_max": {
          "type": "number",
          "minimum": 0.2,
          "maximum": 1
        }
      }
    },
    "comportamientos": {
      "type": "object",
      "maxProperties": 64,
      "description": "Comportamientos propios o que reemplazan a los base (shared/formato/vida/comportamientos.json).",
      "propertyNames": {
        "$ref": "#/$defs/nombreExpresion"
      },
      "additionalProperties": {
        "$ref": "#/$defs/comportamiento"
      }
    }
  },
  "$defs": {
    "colorHex": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "color": {
      "description": "Un token de la marca (tema Pantalla) o un hex.",
      "anyOf": [
        {
          "enum": [
            "naranja",
            "naranja-profundo",
            "pantalla",
            "tinta",
            "tinta-suave",
            "linea"
          ]
        },
        {
          "$ref": "#/$defs/colorHex"
        }
      ]
    },
    "nombreExpresion": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,23}$"
    },
    "num": {
      "type": "number",
      "minimum": -2,
      "maximum": 2
    },
    "medida": {
      "type": "number",
      "minimum": 0,
      "maximum": 2
    },
    "punto": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/num"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "comun": {
      "type": "object",
      "properties": {
        "color": {
          "$ref": "#/$defs/color"
        },
        "fijo": {
          "type": "boolean",
          "description": "No sigue la mirada, la respiración ni el parpadeo (indicadores: zZ, batería, puntos)."
        },
        "audio": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7,
          "description": "Barra de audio: su alto sigue el nivel de la voz."
        },
        "progreso": {
          "type": "boolean",
          "description": "Su ancho sigue el progreso de la tarea en curso (OTA)."
        }
      }
    },
    "expresion": {
      "type": "object",
      "required": [
        "formas"
      ],
      "properties": {
        "nombre": {
          "$ref": "#/$defs/nombreExpresion"
        },
        "numero": {
          "type": "integer"
        },
        "disparador": {
          "type": "string"
        },
        "parpadea": {
          "type": "boolean",
          "default": true
        },
        "formas": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/forma"
          }
        }
      },
      "additionalProperties": false
    },
    "forma": {
      "description": "Primitivas vectoriales en coordenadas normalizadas: centro de la pantalla en (0, 0), el ancho de -1 a 1, escala uniforme (1 = media pantalla de ancho).",
      "oneOf": [
        {
          "type": "object",
          "allOf": [
            {
              "$ref": "#/$defs/comun"
            }
          ],
          "properties": {
            "forma": {
              "const": "pildora"
            },
            "x": {
              "$ref": "#/$defs/num"
            },
            "y": {
              "$ref": "#/$defs/num"
            },
            "w": {
              "$ref": "#/$defs/medida"
            },
            "h": {
              "$ref": "#/$defs/medida"
            },
            "r": {
              "$ref": "#/$defs/medida",
              "description": "Radio de las esquinas. Por defecto, la mitad del lado corto."
            },
            "relleno": {
              "type": "boolean",
              "default": true
            },
            "trazo": {
              "$ref": "#/$defs/medida",
              "description": "Grosor del contorno cuando relleno es false."
            }
          },
          "required": [
            "forma",
            "x",
            "y",
            "w",
            "h"
          ],
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "allOf": [
            {
              "$ref": "#/$defs/comun"
            }
          ],
          "properties": {
            "forma": {
              "const": "corte"
            },
            "x": {
              "$ref": "#/$defs/num"
            },
            "y": {
              "$ref": "#/$defs/num"
            },
            "w": {
              "$ref": "#/$defs/medida"
            },
            "h": {
              "$ref": "#/$defs/medida"
            },
            "izq": {
              "$ref": "#/$defs/medida",
              "description": "Cuánto baja el borde de arriba en el lado izquierdo."
            },
            "der": {
              "$ref": "#/$defs/medida",
              "description": "Cuánto baja el borde de arriba en el lado derecho."
            }
          },
          "required": [
            "forma",
            "x",
            "y",
            "w",
            "h"
          ],
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "allOf": [
            {
              "$ref": "#/$defs/comun"
            }
          ],
          "properties": {
            "forma": {
              "const": "circulo"
            },
            "x": {
              "$ref": "#/$defs/num"
            },
            "y": {
              "$ref": "#/$defs/num"
            },
            "r": {
              "$ref": "#/$defs/medida"
            }
          },
          "required": [
            "forma",
            "x",
            "y",
            "r"
          ],
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "allOf": [
            {
              "$ref": "#/$defs/comun"
            }
          ],
          "properties": {
            "forma": {
              "const": "arco"
            },
            "puntos": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/punto"
              },
              "minItems": 3,
              "maxItems": 3,
              "description": "Inicio, control y fin de una curva cuadrática."
            },
            "trazo": {
              "$ref": "#/$defs/medida"
            }
          },
          "required": [
            "forma",
            "puntos",
            "trazo"
          ],
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "allOf": [
            {
              "$ref": "#/$defs/comun"
            }
          ],
          "properties": {
            "forma": {
              "const": "corazon"
            },
            "x": {
              "$ref": "#/$defs/num"
            },
            "y": {
              "$ref": "#/$defs/num"
            },
            "tamano": {
              "$ref": "#/$defs/medida"
            }
          },
          "required": [
            "forma",
            "x",
            "y"
          ],
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "allOf": [
            {
              "$ref": "#/$defs/comun"
            }
          ],
          "properties": {
            "forma": {
              "const": "espiral"
            },
            "x": {
              "$ref": "#/$defs/num"
            },
            "y": {
              "$ref": "#/$defs/num"
            },
            "r0": {
              "$ref": "#/$defs/medida"
            },
            "paso": {
              "$ref": "#/$defs/medida",
              "description": "Cuánto crece el radio por radián."
            },
            "giro": {
              "type": "number",
              "minimum": 0,
              "maximum": 40,
              "description": "Ángulo total en radianes."
            },
            "trazo": {
              "$ref": "#/$defs/medida"
            }
          },
          "required": [
            "forma",
            "x",
            "y",
            "r0",
            "paso",
            "giro",
            "trazo"
          ],
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "allOf": [
            {
              "$ref": "#/$defs/comun"
            }
          ],
          "properties": {
            "forma": {
              "const": "poligono"
            },
            "puntos": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/punto"
              },
              "minItems": 3,
              "maxItems": 16
            }
          },
          "required": [
            "forma",
            "puntos"
          ],
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "properties": {
            "forma": {
              "const": "franjas"
            },
            "bandas": {
              "type": "array",
              "maxItems": 6,
              "items": {
                "type": "object",
                "required": [
                  "y",
                  "h",
                  "dx"
                ],
                "properties": {
                  "y": {
                    "$ref": "#/$defs/num"
                  },
                  "h": {
                    "$ref": "#/$defs/medida"
                  },
                  "dx": {
                    "$ref": "#/$defs/num"
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "required": [
            "forma",
            "bandas"
          ],
          "description": "Corre en horizontal las franjas de lo ya dibujado (glitch). y es el borde de arriba de cada franja.",
          "unevaluatedProperties": false
        }
      ]
    },
    "animacion": {
      "type": "object",
      "required": [
        "duracion",
        "pistas"
      ],
      "additionalProperties": false,
      "properties": {
        "duracion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000,
          "description": "En milisegundos."
        },
        "repetir": {
          "type": "boolean",
          "description": "Con el comando Reproducir, repite hasta que la paren. En la lista siempre se repite; por una regla, una vez."
        },
        "sobre": {
          "$ref": "#/$defs/nombreExpresion",
          "description": "Una expresión que se dibuja abajo, viva (parpadea y mira)."
        },
        "pistas": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/pista"
          }
        }
      }
    },
    "pista": {
      "type": "object",
      "required": [
        "forma",
        "claves"
      ],
      "additionalProperties": false,
      "properties": {
        "forma": {
          "$ref": "#/$defs/forma",
          "description": "Cualquier forma menos franjas."
        },
        "centro": {
          "$ref": "#/$defs/punto",
          "description": "El centro de la escala y el giro; si no está, el de la forma."
        },
        "claves": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/clave"
          }
        }
      }
    },
    "clave": {
      "type": "object",
      "required": [
        "t"
      ],
      "additionalProperties": false,
      "description": "Cómo está la forma en el instante t. Entre dos claves se interpola con la curva de la primera.",
      "properties": {
        "t": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000,
          "description": "Milisegundos desde el comienzo, en orden y dentro de la duración."
        },
        "x": {
          "type": "number",
          "minimum": -4,
          "maximum": 4,
          "default": 0
        },
        "y": {
          "type": "number",
          "minimum": -4,
          "maximum": 4,
          "default": 0
        },
        "escala": {
          "type": "number",
          "minimum": 0,
          "maximum": 8,
          "default": 1
        },
        "rotacion": {
          "type": "number",
          "minimum": -3600,
          "maximum": 3600,
          "default": 0,
          "description": "Grados, en sentido horario."
        },
        "opacidad": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 1
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "curva": {
          "enum": [
            "lineal",
            "suave",
            "entrada",
            "salida",
            "rebote",
            "paso"
          ],
          "default": "suave"
        }
      }
    },
    "ojo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "w": {
          "type": "number",
          "minimum": 0.03,
          "maximum": 0.2,
          "description": "Medio ancho"
        },
        "h": {
          "type": "number",
          "minimum": 0.03,
          "maximum": 0.32,
          "description": "Medio alto"
        },
        "r": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Redondez (1 = píldora)"
        },
        "tilt": {
          "type": "number",
          "minimum": -0.6,
          "maximum": 0.6,
          "description": "Inclinación (rad)"
        },
        "lt": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.5,
          "description": "Párpado de arriba: cuánto tapa"
        },
        "lta": {
          "type": "number",
          "minimum": -0.8,
          "maximum": 0.8,
          "description": "Ángulo del párpado de arriba (positivo = enojo)"
        },
        "lb": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.5,
          "description": "Párpado de abajo"
        },
        "lba": {
          "type": "number",
          "minimum": -0.8,
          "maximum": 0.8
        },
        "smile": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Arco feliz"
        },
        "heart": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Corazón"
        },
        "star": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Estrella"
        },
        "cross": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Cruz (KO)"
        },
        "ring": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Anillo (cargando)"
        },
        "pupil": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Pupila"
        },
        "squash": {
          "type": "number",
          "minimum": 0.7,
          "maximum": 1.3,
          "description": "Aplastamiento"
        }
      }
    },
    "expresionVida": {
      "type": "object",
      "description": "Una expresión paramétrica: lo que cambia respecto de la neutral (o de la que extiende). \"ojo\" va a los dos; \"izq\" y \"der\", a uno.",
      "additionalProperties": false,
      "properties": {
        "nombre": {
          "$ref": "#/$defs/nombreExpresion"
        },
        "numero": {
          "type": "integer"
        },
        "disparador": {
          "type": "string"
        },
        "extiende": {
          "$ref": "#/$defs/nombreExpresion"
        },
        "ojo": {
          "$ref": "#/$defs/ojo"
        },
        "izq": {
          "$ref": "#/$defs/ojo"
        },
        "der": {
          "$ref": "#/$defs/ojo"
        },
        "movimiento": {
          "enum": [
            "ninguno",
            "rebote",
            "saltitos",
            "risa",
            "mirada-lado",
            "salto",
            "encogerse",
            "dormir",
            "temblor",
            "resoplido",
            "lagrima",
            "achicarse",
            "picaro",
            "latido",
            "bamboleo",
            "escuchar",
            "hablar",
            "pensar",
            "duda",
            "acercarse",
            "suspiro",
            "quieto",
            "cabeceo",
            "carga",
            "orbita",
            "buscar",
            "caer",
            "glitch",
            "estirarse"
          ]
        },
        "particula": {
          "enum": [
            "zzz",
            "corazon",
            "lagrima",
            "gota",
            "chispa",
            "pregunta",
            "exclamacion",
            "nota",
            "estrella",
            "burbuja",
            "ninguna"
          ]
        },
        "parpadeo": {
          "enum": [
            "normal",
            "menos",
            "mas",
            "no",
            "lento",
            "rapido",
            "doble"
          ]
        },
        "gx": {
          "type": "number",
          "minimum": -0.3,
          "maximum": 0.3,
          "description": "Mirada horizontal"
        },
        "gy": {
          "type": "number",
          "minimum": -0.25,
          "maximum": 0.25,
          "description": "Mirada vertical"
        },
        "ey": {
          "type": "number",
          "minimum": -0.25,
          "maximum": 0.25,
          "description": "Altura de la cara"
        },
        "sep": {
          "type": "number",
          "minimum": 0.15,
          "maximum": 0.45,
          "description": "Separación de los ojos"
        },
        "ftilt": {
          "type": "number",
          "minimum": -0.6,
          "maximum": 0.6,
          "description": "Inclinación de la cara"
        },
        "fscale": {
          "type": "number",
          "minimum": 0.7,
          "maximum": 1.3,
          "description": "Escala de la cara"
        },
        "spin": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Remolino (mareo)"
        },
        "orbit": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Los ojos giran"
        },
        "pulse": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Laten con el sonido"
        },
        "beat": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Latido doble"
        },
        "glitch": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "dim": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Cuánto se apaga"
        },
        "hue": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "De naranja a rojo"
        },
        "mo": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.2,
          "description": "Boca: apertura"
        },
        "mw": {
          "type": "number",
          "minimum": 0.02,
          "maximum": 0.2,
          "description": "Boca: ancho"
        },
        "mcurve": {
          "type": "number",
          "minimum": -1,
          "maximum": 1,
          "description": "Boca: sonrisa (+) o puchero (-)"
        },
        "blush": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Cachetes"
        },
        "shake": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Temblor"
        }
      }
    },
    "paso": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cara": {
          "$ref": "#/$defs/nombreExpresion"
        },
        "dura": {
          "oneOf": [
            {
              "type": "number",
              "minimum": 0.05,
              "maximum": 60
            },
            {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0.05,
                "maximum": 60
              },
              "minItems": 2,
              "maxItems": 2
            }
          ],
          "description": "Segundos (o [mínimo, máximo])"
        },
        "veces": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20
              },
              "minItems": 2,
              "maxItems": 2
            }
          ]
        },
        "mirada": {
          "enum": [
            "libre",
            "frente",
            "arriba",
            "abajo",
            "izquierda",
            "derecha",
            "lado",
            "alrededor",
            "perdida",
            "reojo",
            "estimulo",
            "rem",
            "ovejas"
          ]
        },
        "parpadeo": {
          "enum": [
            "normal",
            "menos",
            "mas",
            "no",
            "lento",
            "rapido",
            "doble"
          ]
        },
        "particula": {
          "enum": [
            "zzz",
            "corazon",
            "lagrima",
            "gota",
            "chispa",
            "pregunta",
            "exclamacion",
            "nota",
            "estrella",
            "burbuja"
          ]
        },
        "cuantas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "peso": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "sonido": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8
        },
        "estado": {
          "type": "string",
          "pattern": "^(estado\\.)?(energia|animo|afecto|aburrimiento|curiosidad|sueno|estres)[+-](0(\\.[0-9]+)?|1(\\.0+)?)$"
        }
      }
    },
    "comportamiento": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pasos"
      ],
      "properties": {
        "tipo": {
          "enum": [
            "ocioso",
            "reaccion",
            "rutina"
          ],
          "description": "ocioso: lo elige el selector solo; reaccion: lo dispara una regla; rutina: el ritmo diario."
        },
        "cuando": {
          "type": "string",
          "description": "Condiciones separadas por coma (\"sueno>0.5\", \"rasgo.picardia>0.5\", \"ignorado>240\", \"noche\")."
        },
        "necesidad": {
          "type": "string"
        },
        "base": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "probabilidad": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "enfriamiento": {
          "type": "number",
          "minimum": 0,
          "maximum": 86400
        },
        "interrumpible": {
          "type": "boolean"
        },
        "afinidad": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "energia": {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            },
            "sociabilidad": {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            },
            "picardia": {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            },
            "timidez": {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            },
            "curiosidad": {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            },
            "malGenio": {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            }
          }
        },
        "pasos": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/paso"
          }
        }
      }
    }
  }
}
