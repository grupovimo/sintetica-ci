# Copialo a /opt/sintetica/.env (permisos 600) y generá cada clave con
#   openssl rand -base64 32 | tr -d '/+=' | cut -c1-32
# Nunca va al repo.

# Versión de las imágenes (un sha de commit o "latest").
VERSION=latest

POSTGRES_CLAVE=
MQTT_CLAVE_API=
SECRETO=
EMQX_CLAVE_PANEL=
EMQX_COOKIE=
# El mismo par que está en secretos/emqx-api-claves.txt ("sintetica:<clave>").
EMQX_API_CLAVE=sintetica:

# Quién puede subir firmwares.
ADMIN_EMAILS=
