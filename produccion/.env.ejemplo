# Copialo a /opt/sintetica/.env (permisos 600) y generá cada clave con
#   openssl rand -base64 32 | tr -d '/+=' | cut -c1-32
# Nunca va al repo.

# Versión de las imágenes: siempre un sha de commit probado (no "latest").
VERSION=

POSTGRES_CLAVE=
# El superusuario del broker MQTT (usuario "api"), para mirar desde adentro
# del contenedor. Vacío = nadie entra como superusuario.
MQTT_CLAVE_API=
SECRETO=

# Quién puede subir firmwares.
ADMIN_EMAILS=nahuelsantillan@icloud.com,nsantillandev@gmail.com

# El bot de Telegram (@sinteticalabs_bot): el token lo da @BotFather. Vacío =
# Telegram apagado (el resto anda igual).
TELEGRAM_TOKEN=
TELEGRAM_BOT=sinteticalabs_bot
