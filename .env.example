# Copialo a .env y cambiá lo que haga falta. Todo tiene un valor por defecto
# que anda en local.

# La IP de tu Mac en la red de tu casa (Ajustes del Sistema → Red). Hace falta
# para que una placa real o el celu lleguen a la API y al broker. Con
# "localhost" anda todo lo que corre en la Mac (la web y los bichos virtuales).
IP_LOCAL=localhost

# Dónde abrís la web (para los links de los mails). Si entrás desde el celu,
# poné la IP de la Mac.
IP_WEB=localhost

# Los emails que pueden subir firmwares (separados por comas).
ADMIN_EMAILS=

# Claves locales (cambialas si exponés algo fuera de tu máquina).
POSTGRES_CLAVE=sintetica
MQTT_CLAVE_API=cambiame-api
EMQX_CLAVE_PANEL=sintetica
SECRETO=un-secreto-local-de-al-menos-16-bytes
