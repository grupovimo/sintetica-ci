# Copialo a .env y cambiá lo que haga falta. Todo tiene un valor por defecto
# que anda en local.

# La IP de tu Mac en la red de tu casa (Ajustes del Sistema → Red). Hace falta
# para que una placa real o el celu lleguen a la API y al broker. Con
# "localhost" anda todo lo que corre en la Mac (la web y los bichos virtuales).
IP_LOCAL=localhost

# Dónde abrís la web (para los links de los mails). Si entrás desde el celu,
# poné la IP de la Mac.
IP_WEB=localhost

# Los emails que pueden subir firmwares (separados por comas).
ADMIN_EMAILS=

# Claves locales (cambialas si exponés algo fuera de tu máquina).
POSTGRES_CLAVE=sintetica
# El superusuario del broker MQTT (usuario "api"), para mirar desde afuera
# (mosquitto_sub -u api -P ...). Vacío = nadie entra como superusuario.
MQTT_CLAVE_API=cambiame-api
SECRETO=un-secreto-local-de-al-menos-16-bytes

# El bot de Telegram (@sinteticalabs_bot). Vacío = Telegram apagado.
TELEGRAM_TOKEN=
TELEGRAM_BOT=sinteticalabs_bot

# Spotify (la música de los robots): una app en developer.spotify.com con el
# redirect API_URL_PUBLICA/v1/musica/spotify/vuelta. Vacías = apagado.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# La charla con IA. Una de dos (vacías = apagada):
# - Anthropic (modelo claude-haiku-5-5, o el de CHARLA_MODELO):
ANTHROPIC_API_KEY=
# - Un servicio compatible con la API de chat de OpenAI (gana sobre Anthropic):
#   Groq: CHARLA_URL=https://api.groq.com/openai/v1 y CHARLA_MODELO=llama-3.3-70b-versatile
#   OpenRouter: https://openrouter.ai/api/v1 · Gemini: https://generativelanguage.googleapis.com/v1beta/openai
#   Un Ollama propio: http://ollama:11434/v1 (sin clave).
CHARLA_URL=
CHARLA_CLAVE=
CHARLA_MODELO=
